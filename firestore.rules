rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Productos: Cualquiera puede verlos, solo administradores (opcional) editarlos.
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Solo vía Admin SDK o Seeder
    }

    // 2. Usuarios/Perfiles: Solo el dueño puede ver y escribir su propio perfil.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Órdenes: Solo el dueño de la orden o el staff puede verlas.
    match /orders/{orderId} {
      allow create: if request.auth != null; // Cualquiera logueado puede comprar
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }
    
    // 4. Datos de Usuario (Wishlist): Solo el dueño accede.
    match /user_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
